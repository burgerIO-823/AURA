# Stage 1 / C1 projector alignment: LLM + LoRA frozen, only the MLP projector is trained.
# 55,008 single-source rows, 1 epoch. 4x H100 80GB: 4 GPUs x bs 8 x accum 1 = global batch 32 (1,719 steps).
MANIFEST=data/manifests/train_c1_align.jsonl
EXPECT_ROWS=55008
OUT_DIR=runs/c1_align
INIT=
FREEZE_LLM=1
LR=1e-4
WARMUP=100
GLOBAL_BATCH=32
NUM_GPUS=4
BS=8
SAVE_STEPS=500
EXPECT_STEPS=1719
